{
  "name": "ecosuenos-backend",
  "version": "1.0.0",
  "private": true,
  "description": "API REST de Fundación Ecosueños — Node.js, Express, SQLite y JWT",
  "main": "src/server.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test": "node --test",
    "db:backup": "node scripts/backup.js",
    "db:restore": "node scripts/restore.js",
    "user": "node scripts/users.js",
    "gen:secret": "node -e \"console.log(require('crypto').randomBytes(48).toString('hex'))\""
  },
  "license": "UNLICENSED",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "12.9.0",
    "cors": "^2.8.6",
    "dotenv": "^18.0.9",
    "express": "^4.22.3",
    "express-rate-limit": "^8.7.3",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "mysql2": "^3.24.6"
  },
  "devDependencies": {
    "supertest": "^7.3.1"
  }
}
